# StrokeAegis AI Environment Configuration Template

# Google Gemini API Key for Clinical Multi-Agent CrewAI Flow
STROKE_AEGIS_AGENT_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Dedicated Google Gemini API Key for Medical Chatbot (Isolated Quota)
STROKE_AEGIS_CHATBOT_API_KEY=YOUR_CHATBOT_API_KEY_HERE

# Local PostgreSQL Database Configuration (pgAdmin / Localhost)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=strokeaegis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql+psycopg2://postgres:your_postgres_password_here@127.0.0.1:5432/strokeaegis

# JWT Authentication & Security Configuration
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
